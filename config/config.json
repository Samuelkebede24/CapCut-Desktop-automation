{
    "paths": {
        "watch_folder": "./input_videos",
        "output_folder": "./output_videos",
        "capcut_path": "C:\\Path\\To\\CapCut.exe",
        "assets_path": "./src/assets"
    },
    "filters": {
        "enhancement": "4K",
        "cinematic": "September Sunset"
